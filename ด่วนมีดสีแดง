 -- ========== ค้นหาเป้า ==========
 local function GetTarget()
     local Char = Lp.Character; if not Char then return end
     local Root = Char:FindFirstChild("HumanoidRootPart"); if not Root then return end
     local Nearest, Dist = nil, Set.LockRange
     for _, P in pairs(Players:GetPlayers()) do
         if P ~= Lp and P.Character then
             local PR = P.Character:FindFirstChild("HumanoidRootPart")
             local PH = P.Character:FindFirstChild("Humanoid")
             if PR and PH then
                 if Set.TeamCheck and P.Team == Lp.Team then continue end
                 local D = (Root.Position - PR.Position).Magnitude
                 if D < Dist then Dist, Nearest = D, P end
             end
         end
     end
     return Nearest
 end
 -- ========== ล็อคเป้า ==========
 local function ToggleLock()
     if not State.Enabled then return end
     State.Target = State.Target and nil or GetTarget()
     if State.Target then
         AimBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
         Status.Text = "✅ ล็อค: "..State.Target.Name
     else
         AimBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
         Status.Text = "✅ ระบบทำงานอยู่"
     end
 end
 -- ========== ตามเป้า ==========
 RunService.RenderStepped:Connect(function()
     if State.Enabled and State.Target and State.Target.Character then
         local R = State.Target.Character:FindFirstChild("HumanoidRootPart")
         if R then
             local Cam = workspace.CurrentCamera
             Cam.CFrame = CFrame.new(Cam.CFrame.Position, R.Position + Vector3.new(0, Set.Height, 0))
         end
     end
 end)
 -- ========== ปุ่มควบคุม ==========
 MainToggle.MouseButton1Click:Connect(function()
     State.Enabled = not State.Enabled
     State.MenuOpen = State.Enabled and State.MenuOpen or false
     Menu.Visible = State.MenuOpen
     MainToggle.Text = State.Enabled and "✅" or "❌"
     MainToggle.BackgroundColor3 = State.Enabled and Color3.fromRGB(60,180,80) or Color3.fromRGB(180,60,60)
     Status.Text = State.Enabled and "✅ ระบบทำงานอยู่" or "❌ ระบบปิดอยู่"
     Status.TextColor3 = State.Enabled and Color3.fromRGB(80,220,120) or Color3.fromRGB(220,80,80)
     if not State.Enabled then State.Target = nil end
 end)
 AimBtn.MouseButton1Click:Connect(ToggleLock)
 SaveBtn.MouseButton1Click:Connect(function()
     local N = tonumber(HInput.Text)
     if N then
         Set.Height = math.clamp(N, Set.MinH, Set.MaxH)
         HLabel.Text = "📏 ความสูงเป้า: "..string.format("%.1f", Set.Height).." ม."
         HInput.Text = tostring(Set.Height)
     end
 end)
